# ==========================================================
# Elastic Cloud / OTLP Export
# ==========================================================

# Elastic Cloud の OTLP 取り込みエンドポイント
# 形式: https://<cluster-id>.ingest.<region>.aws.elastic-cloud.com:443
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-cluster-id>.ingest.<region>.aws.elastic-cloud.com:443

# Elastic Cloud の API キー (Base64 エンコード済み)
OTEL_API_KEY=<your-base64-encoded-api-key>

# URL エンコードされた Authorization ヘッダー (通常はそのまま使用可)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20$OTEL_API_KEY

# ==========================================================
# CORS (Nginx OTLPプロキシ用)
# ==========================================================

# フロントエンドを配信するホストのURL (ブラウザからの CORS リクエストの Origin)
# 例: http://<frontend-server-ip>:8080
OTEL_ALLOWED_ORIGIN=http://<frontend-host-ip>:8080

# ==========================================================
# Resource Attributes
# ==========================================================

# サービス名・バージョン・環境を設定する
# service.version が 1.x 系 → 常にSUCCESS、2.x 系 → LATENCY/ERROR を発生させるデモ動作
OTEL_RESOURCE_ATTRIBUTES=service.name=test-card-service,service.version=1.0.0,deployment.environment=production

# ==========================================================
# Exporters
# ==========================================================

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# ==========================================================
# Java Instrumentation
# ==========================================================

OTEL_INSTRUMENTATION_METHODS_INCLUDE=com.example.demo.StatusController[runRedisSet,simulateLatency,simulateRedisLoad]

OTEL_INSTRUMENTATION_JVM_METRICS_ENABLED=true

OTEL_INSTRUMENTATION_HTTP_SERVER_CAPTURE_REQUEST_HEADERS=X-User-ID

OTEL_SEMCONV_STABILITY_OPT_IN=database/dup

OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED=false

OTEL_JAVA_EXPERIMENTAL_SPAN_ATTRIBUTES_COPY_FROM_BAGGAGE_INCLUDE=user.name

# Elastic Java Universal Profiling 連携 (対応 OS のみ有効)
ELASTIC_OTEL_UNIVERSAL_PROFILING_INTEGRATION_ENABLED=true

# ==========================================================
# Python Instrumentation (Python サービス併用時)
# ==========================================================

OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_PYTHON_LOG_CORRELATION=true

# ==========================================================
# Elastic Extras
# ==========================================================

ELASTIC_OTEL_SYSTEM_METRICS_ENABLED=true
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true

# ==========================================================
# Application Config
# ==========================================================

# Redis サーバーのホスト IP とポート
SPRING_REDIS_HOST=<redis-host-ip>
SPRING_REDIS_PORT=6379

REDIS_HOST=<redis-host-ip>
REDIS_PORT=6379

# ==========================================================
# JVM
# ==========================================================

JAVA_OPTS="-Xms128m -Xmx128m"

# --- Kibana (Fleet API) / Elastic Agent: deploy.sh が使用 (app.env には含まれません) ---
KIBANA_URL=https://<your-project>.kb.<region>.aws.elastic.cloud
KIBANA_API_KEY=<Kibana API Key (Fleet 権限)>
KIBANA_AGENT_POLICY_NAME=java_otel_test
