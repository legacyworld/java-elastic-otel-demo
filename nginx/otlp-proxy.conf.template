server {
    listen 4318;

    location /v1/traces {
        add_header Access-Control-Allow-Origin "${OTEL_ALLOWED_ORIGIN}" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, traceparent, tracestate" always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Credentials "true" always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass ${OTEL_EXPORTER_OTLP_ENDPOINT};
        proxy_ssl_server_name on;
        proxy_set_header Authorization "ApiKey ${OTEL_API_KEY}";
        proxy_set_header traceparent $http_traceparent;
        proxy_set_header tracestate $http_tracestate;
        proxy_set_header Content-Type $content_type;

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
    }
}
